{
  "manifest_version": 3,
  "name": "Auto Scroll for Facebook Reels",
  "version": "1.0.0",
  "description": "Automatically scrolls to the next Facebook Reel when the current video finishes playing. Features custom delay, shortcuts, and ad skipping.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/reel/*",
        "*://*.facebook.com/watch/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "content/audioManager.js",
        "content/scroller.js",
        "content/sponsorSkip.js",
        "content/hud.js",
        "content/detector.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle_autoscroll": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Toggle Facebook Reels Auto-Scroll"
    }
  }
}
